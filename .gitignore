supabase/.temp/
supabase/.branches/
supabase/.temp/
supabase/.temp/**
supabase/.branches/

# ---- Editor / tooling local settings ----
.vscode/settings.json
.claude/settings.local.json
.claude/worktrees/

# ---- Scratch / local SQL sessions ----
*.session.sql

# ---- Env / secrets (safety net — never commit these) ----
.env
.env.*
!.env.example
